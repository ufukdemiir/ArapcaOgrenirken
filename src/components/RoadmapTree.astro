---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="w-full bg-white dark:bg-darkbg-card rounded-xl shadow-sm border border-brand-100 dark:border-darkbg-border p-6 my-8">
  <h2 class="text-2xl font-bold mb-6 border-b border-slate-100 dark:border-darkbg-border pb-3 text-brand-700 dark:text-brand-400">2. Aşama: Çekirdek Müfredat</h2>
  <ul class="space-y-4 text-slate-800 dark:text-slate-200">
    <li class="pl-4 border-l-2 border-brand-500">
      <strong class="text-lg text-slate-900 dark:text-white">1. ARAPÇA DİL BİLGİSİ</strong>
      <ul class="mt-2 space-y-3 pl-6 border-l border-slate-200 dark:border-darkbg-border">
        <li>
          <strong class="text-gold-600 dark:text-gold-500">1.1. Sarf (Kelime Morfolojisi ve Yapı Bilgisi)</strong>
          <ul class="mt-2 space-y-2 pl-6 border-l border-slate-200 dark:border-darkbg-border">
            <li>
              <a href={`${baseUrl}/ders-notlari/?kategori=Emsile`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.1.1. Emsile (Temel Kalıplar ve Çekimler)</a>
              <ul class="mt-1 space-y-1 pl-6 list-disc text-sm text-slate-600 dark:text-slate-400">
                <li><span class="italic font-medium">1.1.1.1. Emsile-i Muhtelife (24 Siga):</span> Fiiller, İsimler, Emir ve Nehiyler</li>
                <li><span class="italic font-medium">1.1.1.2. Emsile-i Muttaride:</span> Ma'lûm ve Meçhûl Çekimler</li>
              </ul>
            </li>
            <li><a href={`${baseUrl}/ders-notlari/?kategori=Binâ`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.1.2. Binâ (Fiil Yapıları)</a> - <span class="text-sm text-slate-500">35 Bâb</span></li>
            <li><a href={`${baseUrl}/ders-notlari/?kategori=Maksut`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.1.3. Maksut (Kök Değişimleri ve İ'lâl)</a></li>
            <li><a href={`${baseUrl}/ders-notlari/?kategori=İzzi`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.1.4. İzzî (İleri Sarf Kâideleri)</a></li>
          </ul>
        </li>
        <li class="mt-4">
          <strong class="text-gold-600 dark:text-gold-500">1.2. Nahiv (Cümle Sentaksı ve İrap)</strong>
          <ul class="mt-2 space-y-2 pl-6 border-l border-slate-200 dark:border-darkbg-border">
            <li><a href={`${baseUrl}/ders-notlari/?kategori=Avâmil`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.2.1. Avâmil (Etken ve Etkilenen)</a> - <span class="text-sm text-slate-500">100 Âmil Esası</span></li>
            <li><a href={`${baseUrl}/ders-notlari/?kategori=İzhar`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.2.2. İzhâr (Cümle Bilgisi)</a></li>
            <li><a href={`${baseUrl}/ders-notlari/?kategori=Kâfiye`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">1.2.3. Kâfiye (İleri Nahiv)</a></li>
          </ul>
        </li>
      </ul>
    </li>
  </ul>
</div>