---
const base = import.meta.env.BASE_URL;
const navItems = [
  { path: `${base}yol-haritasi/`, label: 'Yol Haritası' },
  { path: `${base}ders-notlari/`, label: 'Ders Notları' },
  { path: `${base}sozluk/`, label: 'Sözlük' },
  { path: `${base}cumle-defteri/`, label: 'Cümle Defteri' },
  { path: `${base}metinler/`, label: 'Metinler' },
  { path: `${base}blog/`, label: 'Blog' },
  { path: `${base}kaynak-arac/`, label: 'Kaynak & Araç' },
  { path: `${base}istatistikler/`, label: 'İstatistikler' },
  { path: `${base}arsiv/`, label: 'Arşiv' },
];
---
<header class="sticky top-0 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 overflow-x-auto">
      <a href={base} class="flex-shrink-0 pr-6 mr-6 border-r border-gray-300 dark:border-gray-700">
        <div class="font-serif text-xl sm:text-2xl font-bold leading-tight tracking-wide text-gray-900 dark:text-white">
          Arapça<br/>
          <span class="text-indigo-600 dark:text-indigo-400">Öğrenirken</span>
        </div>
      </a>
      <nav class="flex space-x-4 sm:space-x-6 min-w-max items-center">
        {navItems.map(item => (
          <a href={item.path} class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition-colors">
            {item.label}
          </a>
        ))}
        <button id="theme-toggle" class="ml-4 p-2 rounded-full text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          🌙
        </button>
      </nav>
    </div>
  </div>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  });
</script>
