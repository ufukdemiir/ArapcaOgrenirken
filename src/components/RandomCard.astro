---
const { type = 'word', buttonText = "Rastgele Keşfet" } = Astro.props;
---
<div class="bg-brand-50/60 dark:bg-darkbg-card rounded-xl p-6 text-center border border-brand-100 dark:border-darkbg-border shadow-sm">
  <button class="bg-brand-500 hover:bg-brand-600 text-white px-6 py-2.5 rounded-lg font-medium transition-all shadow-sm">
    {buttonText}
  </button>
  <div class="mt-4 min-h-[3rem] flex items-center justify-center text-slate-500 dark:text-slate-400 italic text-sm">
    Rastgele {type === 'word' ? 'kelime' : 'cümle'} keşfi için tıklayın.
  </div>
</div>