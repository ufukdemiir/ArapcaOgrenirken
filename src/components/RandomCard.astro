---
const { type = 'word', buttonText = "Rastgele Keşfet" } = Astro.props;
---
<div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-xl p-6 text-center border border-indigo-100 dark:border-indigo-800">
  <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg font-medium transition-all shadow-sm">
    {buttonText}
  </button>
  <div class="mt-4 min-h-[3rem] flex items-center justify-center text-gray-500 dark:text-gray-400 italic text-sm">
    Rastgele {type === 'word' ? 'kelime' : 'cümle'} keşfi için tıklayın.
  </div>
</div>