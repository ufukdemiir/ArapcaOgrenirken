---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const metinler = await getCollection('metinler');
---
<BaseLayout title="Metinler | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Okuma Metinleri</h1>
    <div class="space-y-6">
      {metinler.map(m => (
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700">
          <span class="text-xs bg-indigo-100 dark:bg-indigo-900/50 text-indigo-800 dark:text-indigo-300 px-2.5 py-1 rounded font-medium">{m.data.level}</span>
          <h2 class="text-2xl font-bold mt-3 mb-4">{m.data.title}</h2>
          <p dir="rtl" class="font-amiri text-2xl leading-loose mb-4">{m.data.arabicText}</p>
          <p dir="ltr" class="text-gray-700 dark:text-gray-300">{m.data.turkishTranslation}</p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>