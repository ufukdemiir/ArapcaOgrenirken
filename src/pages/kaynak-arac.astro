---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const araclar = await getCollection('araclar');
---
<BaseLayout title="Kaynaklar & Araçlar | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Kaynaklar ve Araçlar</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {araclar.map(a => (
        <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
          <span class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">{a.data.type}</span>
          <h2 class="text-xl font-bold mt-2">{a.data.title}</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 mb-4">{a.data.description}</p>
          <a href={a.data.linkOrFile} target="_blank" class="text-indigo-600 dark:text-indigo-400 font-medium text-sm hover:underline">Eriş &rarr;</a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>