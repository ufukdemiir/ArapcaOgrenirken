---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const kelimeler = await getCollection('kelimeler');
---
<BaseLayout title="Sözlük | Arapça Öğrenirken">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold mb-8">Kişisel Sözlük</h1>
    <div dir="rtl" class="flex flex-wrap gap-2 mb-10 p-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 font-amiri text-xl shadow-sm">
      {['ا', 'ب', 'ت', 'ث', 'ج', 'ح', 'خ', 'د', 'ذ', 'ر', 'ز', 'س', 'ش', 'ص', 'ض', 'ط', 'ظ', 'ع', 'غ', 'ف', 'ق', 'ك', 'ل', 'م', 'ن', 'ه', 'و', 'ي'].map(harf => (
        <button class="w-10 h-10 flex items-center justify-center rounded hover:bg-indigo-100 dark:hover:bg-indigo-900 transition-colors text-gray-700 dark:text-gray-300">
          {harf}
        </button>
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {kelimeler.map(k => (
        <div class="bg-white dark:bg-gray-800 p-5 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm flex flex-col justify-between">
          <div>
            <div dir="rtl" class="font-amiri text-3xl mb-2 text-indigo-700 dark:text-indigo-400">{k.data.word}</div>
            <div dir="ltr" class="text-lg font-medium text-gray-800 dark:text-gray-200">{k.data.meaning}</div>
          </div>
          {k.data.exampleSentence && (
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
              <div dir="rtl" class="font-amiri text-lg text-gray-600 dark:text-gray-400 mb-1">{k.data.exampleSentence}</div>
              <div dir="ltr" class="text-sm text-gray-500">{k.data.exampleTranslation}</div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>