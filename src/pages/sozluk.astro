---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const kelimeler = await getCollection('kelimeler');
---
<BaseLayout title="Sözlük | Arapça Öğrenirken">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-slate-900 dark:text-white">Kişisel Sözlük</h1>
    <div dir="rtl" class="flex flex-wrap gap-2 mb-10 p-4 bg-white dark:bg-darkbg-card rounded-xl border border-brand-100 dark:border-darkbg-border font-amiri text-xl shadow-sm">
      {['ا', 'ب', 'ت', 'ث', 'ج', 'ح', 'خ', 'د', 'ذ', 'ر', 'ز', 'س', 'ش', 'ص', 'ض', 'ط', 'ظ', 'ع', 'غ', 'ف', 'ق', 'ك', 'ل', 'م', 'ن', 'ه', 'و', 'ي'].map(harf => (
        <button class="w-10 h-10 flex items-center justify-center rounded hover:bg-brand-50 dark:hover:bg-brand-950/50 text-brand-600 dark:text-brand-400 font-bold transition-colors">
          {harf}
        </button>
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {kelimeler.map(k => (
        <div class="bg-white dark:bg-darkbg-card p-6 rounded-xl border border-brand-100 dark:border-darkbg-border shadow-sm flex flex-col justify-between">
          <div>
            <div dir="rtl" class="font-amiri text-3xl mb-2 text-brand-600 dark:text-brand-400 font-bold">{k.data.word}</div>
            <div dir="ltr" class="text-lg font-medium text-slate-800 dark:text-slate-200">{k.data.meaning}</div>
          </div>
          {k.data.exampleSentence && (
            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-darkbg-border">
              <div dir="rtl" class="font-amiri text-xl text-slate-700 dark:text-slate-300 mb-1">{k.data.exampleSentence}</div>
              <div dir="ltr" class="text-xs text-slate-500">{k.data.exampleTranslation}</div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>