---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cumleler = await getCollection('ornek-cumleler');
---
<BaseLayout title="Cümle Defteri | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-8">Cümle Defteri</h1>
    <div class="space-y-6">
      {cumleler.map(c => (
        <article class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="p-6 md:p-8 bg-gray-50/50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
            <p dir="rtl" class="font-amiri text-2xl md:text-3xl leading-loose text-right text-gray-900 dark:text-white">
              {c.data.arabicSentence}
            </p>
          </div>
          <div class="p-6 md:p-8 space-y-4">
            <p dir="ltr" class="text-lg text-gray-800 dark:text-gray-200 font-medium">
              {c.data.turkishTranslation}
            </p>
            {c.data.irapAnalysis && (
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                <h4 class="text-xs font-bold uppercase tracking-wider text-indigo-500 mb-2">İ'rap Tahlili</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400">{c.data.irapAnalysis}</p>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>