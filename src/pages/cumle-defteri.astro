---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cumleler = await getCollection('ornek-cumleler');
---
<BaseLayout title="Cümle Defteri | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-slate-900 dark:text-white">Cümle Defteri</h1>
    <div class="space-y-6">
      {cumleler.map(c => (
        <article class="bg-white dark:bg-darkbg-card rounded-xl shadow-sm border border-brand-100 dark:border-darkbg-border overflow-hidden">
          <div class="p-6 md:p-8 bg-brand-50/40 dark:bg-darkbg-card/50 border-b border-brand-100 dark:border-darkbg-border">
            <p dir="rtl" class="font-amiri text-2xl md:text-3xl leading-loose text-right text-brand-700 dark:text-brand-400 font-bold">
              {c.data.arabicSentence}
            </p>
          </div>
          <div class="p-6 md:p-8 space-y-4">
            <p dir="ltr" class="text-lg text-slate-800 dark:text-slate-200 font-medium">
              {c.data.turkishTranslation}
            </p>
            {c.data.irapAnalysis && (
              <div class="mt-4 pt-4 border-t border-slate-100 dark:border-darkbg-border">
                <h4 class="text-xs font-bold uppercase tracking-wider text-gold-600 dark:text-gold-500 mb-2">İ'rap Tahlili</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400">{c.data.irapAnalysis}</p>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>