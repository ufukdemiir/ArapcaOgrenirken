---
import BaseLayout from '../layouts/BaseLayout.astro';
import RandomCard from '../components/RandomCard.astro';
---
<BaseLayout>
  <section class="py-12 md:py-16 max-w-3xl mx-auto text-center">
    <div class="inline-block px-3 py-1 bg-brand-50 dark:bg-brand-950/50 text-brand-600 dark:text-brand-400 border border-brand-200 dark:border-brand-900 rounded-full text-xs font-semibold tracking-wide uppercase mb-6">
      Sürtünmesiz Dijital Bahçe
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-slate-900 dark:text-white">
      Kendi Ritminizde <span class="text-brand-500">Arapça Öğrenim</span> Notları
    </h1>
    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-10">
      Klasik gramer müfredatından ilham alan, esnek notlar ve tahlillerle zenginleşen estetik ve sürdürülebilir bir öğrenim bahçesi.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <RandomCard type="word" buttonText="Rastgele Kelime Getir" />
      <RandomCard type="sentence" buttonText="Rastgele Cümle Getir" />
    </div>
  </section>
</BaseLayout>