---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notlar = await getCollection('notlar');
---
<BaseLayout title="Ders Notları | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Ders Notları</h1>
    <div class="grid gap-4">
      {notlar.map(n => (
        <article class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-indigo-500 transition-colors">
          <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">{n.data.category}</span>
          <h2 class="text-2xl font-bold mt-1 mb-2">{n.data.title}</h2>
          <div class="text-sm text-gray-500">{new Date(n.data.publishDate).toLocaleDateString('tr-TR')}</div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>