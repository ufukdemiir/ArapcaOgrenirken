---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapTree from '../components/RoadmapTree.astro';
---
<BaseLayout title="Yol Haritası | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-4">Öğrenim Yol Haritası</h1>
      <p class="text-gray-600 dark:text-gray-400">Doğrulanmış klasik müfredat hiyerarşisi ile adım adım ilerleme kaydedin.</p>
    </header>
    <div class="space-y-8">
      <section class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm opacity-90">
        <h2 class="text-xl font-bold mb-3 text-gray-700 dark:text-gray-300">1. Aşama: Hazırlık (Öncesi)</h2>
        <p class="text-gray-600 dark:text-gray-400">Elif-ba, harf birleşimleri ve temel okuma pratikleri rehberi.</p>
      </section>
      <RoadmapTree />
      <section class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm opacity-90">
        <h2 class="text-xl font-bold mb-3 text-gray-700 dark:text-gray-300">3. Aşama: Tatbikat ve Derinleşme (Sonrası)</h2>
        <p class="text-gray-600 dark:text-gray-400">Metin okumaları, ayet/hadis tahlilleri, klasik edebiyat ve Belâgat çalışmaları.</p>
      </section>
    </div>
  </div>
</BaseLayout>