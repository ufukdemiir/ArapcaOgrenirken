---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---
<BaseLayout title="Blog | Arapça Öğrenirken">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Blog & Süreç Notları</h1>
    <div class="space-y-4">
      {posts.map(p => (
        <article class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
          <span class="text-xs text-indigo-500 font-semibold uppercase">{p.data.postType}</span>
          <h2 class="text-2xl font-bold mt-1">{p.data.title}</h2>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>